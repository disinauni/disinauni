---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import LanguageToggle from '@/components/LanguageToggle.astro'
import { projects } from '@/data/projects'
import { t, type Lang } from '@/lib/i18n'

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }]
}

const lang = Astro.params.lang as Lang
const s = t(lang)
---

<BaseLayout lang={lang} title={s.meta.title} description={s.meta.description}>
  <!-- Top bar: theme + language toggle -->
  <header class="sticky top-0 z-50 backdrop-blur bg-white/70 dark:bg-slate-950/70 border-b border-slate-200/60 dark:border-slate-800/60">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href={`/${lang}`} class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
        <img src="/favicon.svg" width="24" height="24" alt="" class="rounded-md" />
        disinauni
      </a>
      <div class="flex items-center gap-1">
        <LanguageToggle lang={lang} currentPath={Astro.url.pathname} />
        <ThemeToggle />
      </div>
    </div>
  </header>

  <main id="main-content" class="min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-br from-primary-50 via-white to-accent-50 dark:from-primary-950 dark:via-slate-950 dark:to-accent-950"
      >
      </div>

      <div class="max-w-5xl mx-auto px-6 pt-16 pb-16 text-center">
        <img src="/favicon.svg" width="72" height="72" alt="disinauni" class="mx-auto mb-6 rounded-2xl shadow-lg" />

        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">disinauni</h1>

        <p class="mt-4 text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          <strong>{s.hero.tagline}</strong>
        </p>

        <p class="mt-6 text-base text-slate-500 dark:text-slate-500 max-w-xl mx-auto">
          {s.hero.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#proyek"
            class="rounded-full bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-3 transition-colors"
          >
            {s.hero.ctaProjects}
          </a>
          <a
            href="https://github.com/disinauni"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-slate-300 dark:border-slate-700 hover:border-primary-400 text-slate-700 dark:text-slate-300 font-semibold px-6 py-3 transition-colors"
          >
            {s.hero.ctaGithub}
          </a>
        </div>
      </div>
    </section>

    <!-- Filosofi -->
    <section class="max-w-4xl mx-auto px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-slate-900 dark:text-white">{s.philosophy.title}</h2>
      <p class="mt-3 text-center text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        {s.philosophy.intro}
      </p>

      <div class="mt-10 grid sm:grid-cols-3 gap-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-6 text-center">
          <div class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">DI</div>
          <div class="mt-2 font-semibold text-slate-800 dark:text-slate-200">{s.philosophy.di.label}</div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-500">{s.philosophy.di.desc}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-6 text-center">
          <div class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">SINAU</div>
          <div class="mt-2 font-semibold text-slate-800 dark:text-slate-200">{s.philosophy.sinau.label}</div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-500">{s.philosophy.sinau.desc}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-6 text-center">
          <div class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">NI</div>
          <div class="mt-2 font-semibold text-slate-800 dark:text-slate-200">{s.philosophy.ni.label}</div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-500">{s.philosophy.ni.desc}</p>
        </div>
      </div>
    </section>

    <!-- Proyek -->
    <section id="proyek" class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-slate-900 dark:text-white">{s.projects.title}</h2>
      <p class="mt-3 text-center text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        {s.projects.subtitle}
      </p>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => <ProjectCard project={project} lang={lang} ctaLabel={s.projects.cta} />)}
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800 py-10">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-500 dark:text-slate-500">{s.footer.credit}</p>
        <a
          href="https://github.com/disinauni"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-slate-500 dark:text-slate-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          github.com/disinauni
        </a>
      </div>
    </footer>
  </main>
</BaseLayout>
